# Copie para .env.local ou use neon env pull. Nunca use o prefixo VITE_ para credenciais.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
PORT=5173

# Acesso administrativo (somente no servidor).
ADMIN_USERNAME=
# Formato salt:hash, derivado com scrypt(password, salt, 64).
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Defina 1 apenas quando houver exatamente um proxy confiável na frente do app.
TRUST_PROXY=0
